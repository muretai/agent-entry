{
  "name": "@muretai/agent-entry",
  "version": "1.10.0",
  "description": "Serve /.well-known/agent-card.json, then answer a signed POST: verify who is knocking, open an account from their key, reply signed — one HTTP round trip. Coexists with llms.txt, WebMCP, and MCP; replaces none of them. Any A2A client. Zero dependencies.",
  "type": "module",
  "main": "muretai-agent-entry.mjs",
  "exports": {
    ".": "./muretai-agent-entry.mjs"
  },
  "files": [
    "muretai-agent-entry.mjs",
    "conformance/",
    "examples/server.mjs",
    "diagrams/",
    "scripts/distill/",
    "LICENSE",
    "spec/",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node conformance/run.mjs",
    "example": "node examples/server.mjs",
    "distill": "node scripts/distill/loop.mjs",
    "distill:record": "node scripts/distill/record.mjs",
    "distill:measure": "node scripts/distill/measure.mjs"
  },
  "keywords": [
    "ai-agent",
    "ai-agents",
    "agent",
    "a2a",
    "agent-card",
    "llms-txt",
    "webmcp",
    "mcp",
    "ai-crawler",
    "agentic",
    "did",
    "ed25519",
    "muretai",
    "agent-network"
  ],
  "license": "MIT",
  "author": "Muretai",
  "homepage": "https://muretai.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muretai/agent-entry.git"
  },
  "bugs": {
    "url": "https://github.com/muretai/agent-entry/issues"
  }
}
