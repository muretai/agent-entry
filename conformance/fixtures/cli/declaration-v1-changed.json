{
  "v": 1,
  "entry": { "name": "Harbor Lamp", "baseUrl": "https://shop.example" },
  "offers": [
    { "verb": "find", "of": "products", "about": "Find lamps by words or category.",
      "input": { "q": "string" },
      "page": { "on": ["/shop/**"], "do": { "fetch": { "method": "GET", "path": "/wp-json/wc/store/v1/products", "query": { "search": "q" } } } },
      "door": { "reply": "catalog" } },
    { "verb": "hold", "of": "item", "about": "Hold one lamp for pickup within 72 hours.",
      "input": { "sku": "string" },
      "door": { "reply": "pending" } },
    { "verb": "ask", "of": "anything", "about": "Ask the shop a question.",
      "input": { "text": "string" },
      "door": { "reply": "human" } }
  ]
}
