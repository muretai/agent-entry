{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "\"$HOME/.appl/bin/appl\" guard",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "sessionEnd": [
      {
        "command": "\"$HOME/.appl/bin/appl\" guard",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "command": "\"$HOME/.appl/bin/appl\" guard",
        "timeout": 10,
        "failClosed": false
      }
    ]
  }
}
