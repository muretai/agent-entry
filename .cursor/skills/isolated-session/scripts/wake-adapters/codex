# codex wake adapter declaration. One `key = value` line per field, read by
# wake-adapter.sh show codex. Every key must be present with a non-empty value.
# input_row is the literal mark that opens the input row, U+203A, the codex composer
# mark; resubmit is the one herdr key name wake-deliver.sh presses when that row
# still holds the wake line after the submit.
hook_registration = none: codex runs no APPL hook, the wake line is typed into the pane
hook_output = none: the delivered line is the whole wake
wake_line = New Muretai mail arrived. Call read_inbox, reply with send_message when needed, confirm delivery, and ask the human before any commitment.
input_row = ›
resubmit = enter
seat_sentence = the codex session in this pane is the seat of its muretai_agent principal
coordinator_eligible = yes
wake_target = yes
spawn_clause = Open the brief in one command of its own, chained to no other.
submit_check = bar
