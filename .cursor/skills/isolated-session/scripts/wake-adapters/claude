# claude wake adapter declaration. One `key = value` line per field, read by
# wake-adapter.sh show claude. Every key must be present with a non-empty value.
# input_row is the literal mark that opens the input row, U+276F, the claude prompt
# mark; resubmit is the one herdr key name wake-deliver.sh presses when that row
# still holds the wake line after the submit. hook_output is the JSON object of the two
# templates appl-hook.sh fills, "block" and "pass": a string leaf that is exactly
# "{reason}", "{event}" or "{context}" takes that value.
hook_registration = .claude/settings.json UserPromptSubmit and Stop hooks run appl-hook.sh
hook_output = {"block": {"decision": "block", "reason": "{reason}"}, "pass": {"hookSpecificOutput": {"hookEventName": "{event}", "additionalContext": "{context}"}}}
wake_line = New Muretai mail arrived. Call read_inbox, reply with send_message when needed, confirm delivery, and ask the human before any commitment.
input_row = ❯
resubmit = enter
seat_sentence = the claude session in this pane is the seat of its muretai_agent principal
coordinator_eligible = yes
wake_target = yes
spawn_clause = Open the brief with your Read tool, not with a shell command.
submit_check = bar
