# grok wake adapter declaration. One `key = value` line per field, read by
# wake-adapter.sh show grok. Every key must be present with a non-empty value.
# grok is walled: it never wakes the coordinator principal.
# input_row is the literal mark that opens the input row, U+276F, the grok input
# prompt mark; resubmit is the one herdr key name wake-deliver.sh presses when that
# row still holds the wake line after the submit. Worker delivery only.
hook_registration = none: grok runs no APPL hook, the wake line is typed into the pane
hook_output = none: the delivered line is the whole wake
wake_line = New Muretai mail arrived. Call read_inbox, reply with send_message when needed, confirm delivery, and ask the human before any commitment.
input_row = ❯
resubmit = enter
seat_sentence = the grok session in this pane is a walled worker seat, never a coordinator seat
coordinator_eligible = no
wake_target = no
spawn_clause = none
submit_check = bar
